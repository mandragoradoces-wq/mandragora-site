{
  // API de pagamento da Mandrágora (o site em si fica no GitHub Pages)
  "name": "mandragora-site",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // mantém as variáveis que vocês cadastrarem pelo painel
  "keep_vars": true
  // OPCIONAL (evita e-mail repetido): crie o KV "mandragora-pedidos" no Cloudflare,
  // coloque uma vírgula no fim da linha "keep_vars" acima, tire as duas barras
  // da linha abaixo e cole o ID do KV no lugar indicado:
  // "kv_namespaces": [{ "binding": "PEDIDOS", "id": "COLE_AQUI_O_ID_DO_KV" }]
}
